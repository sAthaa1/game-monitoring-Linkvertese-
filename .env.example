# Discord bot token
DISCORD_TOKEN=your_discord_bot_token_here

# Channel IDs to post monitoring embeds (comma-separated)
MONITOR_CHANNEL_IDS=123456789012345678

# Display name shown in the embed (leave blank to use Roblox game name)
GAME_DISPLAY_NAME=My Game

# Linkvertise settings
USE_LINKVERTISE=false
LINKVERTISE_USER_ID=

# Instant Play button (requires role check)
SHOW_INSTANT_PLAY=false
INSTANT_PLAY_ROLE_IDS=123456789012345678

# Optional: Roblox group URL shown in embed
GROUP_URL=

# How often to check game status (seconds)
CHECK_INTERVAL=10

# Target place file path
TARGET_PLACE_FILE=target_place.json

# Roblox cookie (used for maturity checks)
ROBLOSECURITY=your_roblosecurity_cookie_here

# Selfbot / share bot tokens (optional)
SELFBOT_TOKEN=
SHAREBOT_TOKEN=
SHARE_CHANNEL_ID=
